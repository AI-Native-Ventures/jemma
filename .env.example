# Copy to .env.local at the repo root (apps/web reads it; setup copies it to apps/agent/.dev.vars).

# Supabase project URL (jemma-dev or jemma-demo)
SUPABASE_URL=
# Supabase anon key, used by the web app under row-level security
SUPABASE_ANON_KEY=
# Supabase service role key, server and agent only, never sent to the browser
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string for `supabase db push`
SUPABASE_DB_URL=
# Supabase project ref for `supabase gen types`
SUPABASE_PROJECT_ID=

# Text model provider, default deepseek
LLM_PROVIDER=
# Text model id for LLM_PROVIDER
LLM_MODEL=
# Vision model provider (reads photos)
VISION_PROVIDER=
# Vision model id for VISION_PROVIDER
VISION_MODEL=
# Speech provider (lesson audio)
TTS_PROVIDER=
# Speech model id for TTS_PROVIDER
TTS_MODEL=
# live, record or replay: how the replay layer treats model calls
AI_MODE=

# OpenRouter key, deepseek routes through it unless DEEPSEEK_API_KEY is set
OPENROUTER_API_KEY=
# DeepSeek direct key (optional)
DEEPSEEK_API_KEY=
# OpenAI key (optional provider)
OPENAI_API_KEY=
# Anthropic key (optional provider)
ANTHROPIC_API_KEY=
# Google Generative AI key (optional provider)
GOOGLE_GENERATIVE_AI_API_KEY=

# Base URL of the agent worker, e.g. http://localhost:8787
AGENT_URL=
# Shared secret the web app sends as x-jemma-secret to POST /events
EVENTS_SECRET=
# agentic or fixed: forces how the orchestrator runs an event
AGENT_MODE=
# Server-side pepper for hashing child PINs
CHILD_PIN_PEPPER=

# Days a gap must stay practised before it can be marked fixed
FIX_AFTER_DAYS=
# Minimum read confidence (0 to 1, default 0.8) before an answer needs a check
READ_CONFIDENCE_MIN=

# OpenCode Zen key, used when LLM_PROVIDER or VISION_PROVIDER is opencode
OPENCODE_API_KEY=
# OpenCode Zen base URL, default https://opencode.ai/zen/v1
OPENCODE_BASE_URL=
