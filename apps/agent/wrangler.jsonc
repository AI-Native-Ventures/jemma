{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jemma-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "queues": {
    "producers": [{ "queue": "jemma-events", "binding": "EVENTS_QUEUE" }],
    "consumers": [
      {
        "queue": "jemma-events",
        "max_batch_size": 1,
        "max_retries": 3,
        "dead_letter_queue": "jemma-events-dlq"
      }
    ]
  }
}
