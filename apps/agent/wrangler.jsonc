{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jemma-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI" },
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "triggers": { "crons": ["* * * * *"] },
  "vars": { "TTS_PROVIDER": "workers-ai", "TTS_MODEL": "@cf/deepgram/aura-2-en" },
  "queues": {
    "producers": [{ "queue": "jemma-events", "binding": "EVENTS_QUEUE" }],
    "consumers": [
      {
        "queue": "jemma-events",
        "max_batch_size": 3,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "dead_letter_queue": "jemma-events-dlq"
      }
    ]
  }
}
