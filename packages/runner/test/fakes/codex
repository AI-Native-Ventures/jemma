#!/usr/bin/env node
// Fake `codex` for runner tests. Same FAKE_MODE and FAKE_LOG as the fake claude.
import { appendFileSync } from 'node:fs'
import { spawn } from 'node:child_process'

const args = process.argv.slice(2)
const log = (o) => process.env.FAKE_LOG && appendFileSync(process.env.FAKE_LOG, JSON.stringify(o) + '\n')
const out = (o) => process.stdout.write(JSON.stringify(o) + '\n')

if (args[0] === '--version') {
  console.log('codex-cli 9.9.9')
  process.exit(0)
}
if (args[0] === 'login' && args[1] === 'status') {
  if (process.env.FAKE_SIGNED_IN === 'no') {
    console.error('Not logged in')
    process.exit(1)
  }
  console.log('Logged in using ChatGPT')
  process.exit(0)
}

let stdin = ''
for await (const chunk of process.stdin) stdin += chunk
log({ bin: 'codex', args, stdin, cwd: process.cwd(), token: process.env.JEMMA_MCP_TOKEN ?? null })

const mode = process.env.FAKE_MODE ?? 'done'
if (mode === 'hang') {
  const child = spawn(process.execPath, ['-e', 'setInterval(() => {}, 1000)'], { stdio: 'ignore' })
  log({ childPid: child.pid })
  setInterval(() => {}, 1000)
} else {
  out({ type: 'thread.started', thread_id: 't1' })
  if (mode === 'done' || mode === 'failed') {
    out({
      type: 'item.completed',
      item: { id: 'i1', type: 'mcp_tool_call', server: 'jemma', tool: 'complete_job', arguments: { eventId: 'e', status: mode === 'failed' ? 'failed' : 'done' }, status: 'completed' },
    })
  }
  out({ type: 'item.completed', item: { id: 'i2', type: 'agent_message', text: mode === 'silent' ? 'I looked and stopped.' : 'All finished.' } })
  out({ type: 'turn.completed', usage: {} })
}
