{
  "name": "jemma",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "test": "vitest run",
    "typecheck": "pnpm -r --parallel typecheck",
    "operator": "pnpm --filter @jemma/runner operator",
    "evals": "pnpm --filter @jemma/runner exec node --import tsx --import ../profiling/scripts/register-md.mjs ../../evals/run.ts",
    "evals:report": "pnpm --filter @jemma/runner exec node --import tsx --import ../profiling/scripts/register-md.mjs ../../evals/report.ts"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "@types/node": "24.10.1",
    "supabase": "2.122.1"
  }
}
